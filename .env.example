# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/sentinel?schema=public

# HTTP server.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API directly.
# Local Vite and Docker Nginx are same-origin via proxy, so this mainly covers direct API use.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# When true, external feeds are not called. The simulator creates, updates, and resolves incidents.
DEMO_MODE=true

# How often providers are polled, in milliseconds. Minimum 5000.
POLLING_INTERVAL_MS=15000

# Public feeds used when DEMO_MODE=false. No API key is required.
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
WILDFIRE_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events?status=open&limit=200

# Upstream request timeout and retry count. Failures are logged and do not crash the API.
PROVIDER_TIMEOUT_MS=12000
PROVIDER_MAX_RETRIES=3
